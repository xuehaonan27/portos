      }
    },
    "wait_for": {
      "description": "Wait for a selector to appear, for the network to go idle, or for a number of milliseconds.",
      "args": {
        "type": "object",
        "properties": {
          "selector": {
            "type": "string"
          },
          "ms": {
            "type": "number"
          },
          "network_idle": {
            "type": "boolean"
          }
        }
      },
      "reply": {
        "type": "object",
        "required": [
          "ok",
          "waited"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "waited": {
            "type": "string"
          }
        }
      }
    },
    "screenshot": {
      "description": "Take a screenshot. Returns a handle to the stored image and its path — never the image itself.",
      "args": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        }
      },
      "reply": {
        "type": "object",
        "required": [
          "handle",
          "size",
          "type",
          "path"
        ],
        "properties": {
          "handle": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          },
          "type": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      }
    },
    "login_passthrough": {
      "description": "Hand the window to the person, to log in or pass a check. Passwords and passkeys never reach the agent; call `resume` when they are done.",
      "args": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        }
      },
      "reply": {
        "type": "object",
        "required": [
          "mode",
          "hint"
        ],
        "properties": {
          "mode": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          }
        }
      }
    },
    "resume": {
      "description": "Take the browser back after a passthrough.",
      "args": {
        "type": "object",
        "properties": {}
      },
      "reply": {
        "type": "object",
        "required": [
          "mode",
          "url"
        ],
        "properties": {
          "mode": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "logged_in_hint": {
            "type": "string"
          }
        }
      }
