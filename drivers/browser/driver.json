    "click": {
      "description": "Click the element `ref` points at. Pass `expect_name` to be told if the element under that ref is no longer the one you saw.",
      "args": {
        "type": "object",
        "required": [
          "ref"
        ],
        "properties": {
          "ref": {
            "type": "string"
          },
          "expect_name": {
            "type": "string"
          }
        }
      },
      "reply": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "handle",
              "size",
              "preview"
            ],
            "properties": {
              "handle": {
                "type": "string"
              },
              "size": {
                "type": "integer"
              },
              "preview": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "snapshot_id",
              "url",
              "title",
              "element_count",
              "elements"
            ],
            "properties": {
              "snapshot_id": {
                "type": "integer"
              },
              "url": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "element_count": {
                "type": "integer"
              },
              "elements": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "ref",
                    "role",
                    "name",
                    "editable"
                  ],
                  "properties": {
                    "ref": {
                      "type": "string"
                    },
                    "role": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "editable": {
                      "type": "boolean"
                    },
                    "tag": {
                      "type": "string"
                    },
                    "visible": {
                      "type": "boolean"
                    },
                    "bbox": {
                      "type": "object",
                      "required": [
                        "x",
