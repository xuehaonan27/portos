                }
              },
              "stale_warning": {
                "type": "string"
              }
            }
          }
        ]
      },
      "bulk": {
        "type": "web/page-snapshot"
      }
    },
    "type": {
      "description": "Type `text` into the element `ref` points at; `submit` presses Enter afterwards. `expect_name` as for click.",
      "args": {
        "type": "object",
        "required": [
          "ref",
          "text"
        ],
        "properties": {
          "ref": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "expect_name": {
            "type": "string"
          },
          "submit": {
            "type": "boolean"
          }
        }
      },
      "reply": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "handle",
              "size",
              "preview"
            ],
            "properties": {
              "handle": {
                "type": "string"
              },
              "size": {
                "type": "integer"
              },
              "preview": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "snapshot_id",
              "url",
              "title",
              "element_count",
              "elements"
            ],
            "properties": {
              "snapshot_id": {
                "type": "integer"
              },
              "url": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "element_count": {
                "type": "integer"
              },
              "elements": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "ref",
                    "role",
                    "name",
                    "editable"
                  ],
                  "properties": {
                    "ref": {
                      "type": "string"
                    },
                    "role": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "editable": {
                      "type": "boolean"
                    },
                    "tag": {
                      "type": "string"
                    },
                    "visible": {
