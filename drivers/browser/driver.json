{
  "driver": "browser",
  "verbs": {
    "open": {
      "description": "Open the browser (it has a profile of its own) and, if `url` is given, go there. Returns the page's element table: every interactive element, each with a short-lived `ref` to act on.",
      "args": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        }
      },
      "reply": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "handle",
              "size",
              "preview"
            ],
            "properties": {
              "handle": {
                "type": "string"
              },
              "size": {
                "type": "integer"
              },
              "preview": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "snapshot_id",
              "url",
              "title",
              "element_count",
              "elements"
            ],
            "properties": {
              "snapshot_id": {
                "type": "integer"
              },
              "url": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "element_count": {
                "type": "integer"
              },
              "elements": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "ref",
                    "role",
                    "name",
                    "editable"
                  ],
                  "properties": {
                    "ref": {
                      "type": "string"
                    },
                    "role": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "editable": {
                      "type": "boolean"
                    },
                    "tag": {
                      "type": "string"
                    },
                    "visible": {
                      "type": "boolean"
                    },
                    "bbox": {
                      "type": "object",
                      "required": [
                        "x",
                        "y",
                        "w",
                        "h"
                      ],
                      "properties": {
                        "x": {
                          "type": "number"
                        },
                        "y": {
                          "type": "number"
                        },
                        "w": {
                          "type": "number"
                        },
                        "h": {
                          "type": "number"
                        }
                      }
                    }
                  }
                }
              },
              "stale_warning": {
                "type": "string"
              }
            }
          }
        ]
      },
      "bulk": {
        "type": "web/page-snapshot"
      }
    },
    "navigate": {
      "description": "Go to `url`. Returns the new element table.",
      "args": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string"
          }
        }
      },
      "reply": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "handle",
              "size",
              "preview"
            ],
            "properties": {
              "handle": {
                "type": "string"
              },
              "size": {
                "type": "integer"
              },
              "preview": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "snapshot_id",
              "url",
              "title",
              "element_count",
              "elements"
            ],
            "properties": {
              "snapshot_id": {
                "type": "integer"
              },
              "url": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "element_count": {
                "type": "integer"
              },
              "elements": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "ref",
                    "role",
                    "name",
                    "editable"
                  ],
                  "properties": {
                    "ref": {
                      "type": "string"
                    },
                    "role": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "editable": {
                      "type": "boolean"
                    },
                    "tag": {
                      "type": "string"
                    },
                    "visible": {
                      "type": "boolean"
                    },
                    "bbox": {
                      "type": "object",
                      "required": [
                        "x",
                        "y",
                        "w",
                        "h"
                      ],
                      "properties": {
                        "x": {
                          "type": "number"
                        },
                        "y": {
                          "type": "number"
                        },
                        "w": {
                          "type": "number"
                        },
                        "h": {
                          "type": "number"
                        }
                      }
                    }
                  }
                }
              },
              "stale_warning": {
                "type": "string"
              }
            }
          }
        ]
      },
      "bulk": {
        "type": "web/page-snapshot"
      }
    },
    "snapshot": {
      "description": "Re-read the current page's element table with fresh refs. `with_bbox` adds each element's position.",
      "args": {
        "type": "object",
        "properties": {
          "with_bbox": {
            "type": "boolean"
          }
        }
      },
      "reply": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "handle",
              "size",
              "preview"
            ],
            "properties": {
              "handle": {
                "type": "string"
              },
              "size": {
                "type": "integer"
              },
              "preview": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "snapshot_id",
              "url",
              "title",
              "element_count",
              "elements"
            ],
            "properties": {
              "snapshot_id": {
                "type": "integer"
              },
              "url": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "element_count": {
                "type": "integer"
              },
              "elements": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "ref",
                    "role",
                    "name",
                    "editable"
                  ],
                  "properties": {
                    "ref": {
                      "type": "string"
                    },
                    "role": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "editable": {
                      "type": "boolean"
                    },
                    "tag": {
                      "type": "string"
                    },
                    "visible": {
                      "type": "boolean"
                    },
                    "bbox": {
                      "type": "object",
                      "required": [
                        "x",
                        "y",
                        "w",
                        "h"
                      ],
                      "properties": {
                        "x": {
                          "type": "number"
                        },
                        "y": {
                          "type": "number"
                        },
                        "w": {
                          "type": "number"
                        },
                        "h": {
                          "type": "number"
                        }
                      }
                    }
                  }
                }
              },
              "stale_warning": {
                "type": "string"
              }
            }
          }
        ]
      },
      "bulk": {
        "type": "web/page-snapshot"
      }
